{
  "name": "cryptovalid",
  "version": "0.5.1",
  "description": "Lightweight crypto address validator with checksum verification for Bitcoin, Ethereum, Solana and more",
  "keywords": [
    "address-validator",
    "base58",
    "bech32",
    "bitcoin",
    "checksum",
    "crypto-address-validator",
    "eip55",
    "ethereum",
    "solana",
    "wallet"
  ],
  "homepage": "https://github.com/fantasy42/cryptovalid#readme",
  "bugs": {
    "url": "https://github.com/fantasy42/cryptovalid/issues"
  },
  "license": "MIT",
  "author": "Fantasy <fntsy42@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fantasy42/cryptovalid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./any": {
      "import": {
        "types": "./dist/any.d.mts",
        "default": "./dist/any.mjs"
      },
      "require": {
        "types": "./dist/any.d.cts",
        "default": "./dist/any.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.mts",
        "default": "./dist/constants.mjs"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      }
    },
    "./bnb": {
      "import": {
        "types": "./dist/bnb.d.mts",
        "default": "./dist/bnb.mjs"
      },
      "require": {
        "types": "./dist/bnb.d.cts",
        "default": "./dist/bnb.cjs"
      }
    },
    "./btc": {
      "import": {
        "types": "./dist/btc.d.mts",
        "default": "./dist/btc.mjs"
      },
      "require": {
        "types": "./dist/btc.d.cts",
        "default": "./dist/btc.cjs"
      }
    },
    "./eth": {
      "import": {
        "types": "./dist/eth.d.mts",
        "default": "./dist/eth.mjs"
      },
      "require": {
        "types": "./dist/eth.d.cts",
        "default": "./dist/eth.cjs"
      }
    },
    "./ltc": {
      "import": {
        "types": "./dist/ltc.d.mts",
        "default": "./dist/ltc.mjs"
      },
      "require": {
        "types": "./dist/ltc.d.cts",
        "default": "./dist/ltc.cjs"
      }
    },
    "./polygon": {
      "import": {
        "types": "./dist/polygon.d.mts",
        "default": "./dist/polygon.mjs"
      },
      "require": {
        "types": "./dist/polygon.d.cts",
        "default": "./dist/polygon.cjs"
      }
    },
    "./sol": {
      "import": {
        "types": "./dist/sol.d.mts",
        "default": "./dist/sol.mjs"
      },
      "require": {
        "types": "./dist/sol.d.cts",
        "default": "./dist/sol.cjs"
      }
    },
    "./ton": {
      "import": {
        "types": "./dist/ton.d.mts",
        "default": "./dist/ton.mjs"
      },
      "require": {
        "types": "./dist/ton.d.cts",
        "default": "./dist/ton.cjs"
      }
    },
    "./trx": {
      "import": {
        "types": "./dist/trx.d.mts",
        "default": "./dist/trx.mjs"
      },
      "require": {
        "types": "./dist/trx.d.cts",
        "default": "./dist/trx.cjs"
      }
    },
    "./xlm": {
      "import": {
        "types": "./dist/xlm.d.mts",
        "default": "./dist/xlm.mjs"
      },
      "require": {
        "types": "./dist/xlm.d.cts",
        "default": "./dist/xlm.cjs"
      }
    },
    "./xrp": {
      "import": {
        "types": "./dist/xrp.d.mts",
        "default": "./dist/xrp.mjs"
      },
      "require": {
        "types": "./dist/xrp.d.cts",
        "default": "./dist/xrp.cjs"
      }
    },
    "./usdt-bep20": {
      "import": {
        "types": "./dist/usdt-bep20.d.mts",
        "default": "./dist/usdt-bep20.mjs"
      },
      "require": {
        "types": "./dist/usdt-bep20.d.cts",
        "default": "./dist/usdt-bep20.cjs"
      }
    },
    "./usdt-erc20": {
      "import": {
        "types": "./dist/usdt-erc20.d.mts",
        "default": "./dist/usdt-erc20.mjs"
      },
      "require": {
        "types": "./dist/usdt-erc20.d.cts",
        "default": "./dist/usdt-erc20.cjs"
      }
    },
    "./usdt-trc20": {
      "import": {
        "types": "./dist/usdt-trc20.d.mts",
        "default": "./dist/usdt-trc20.mjs"
      },
      "require": {
        "types": "./dist/usdt-trc20.d.cts",
        "default": "./dist/usdt-trc20.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:exports": "vpx scripts/generateExports.ts",
    "build": "vp run gen:exports && vp pack && node scripts/checkDistTypes.mjs",
    "dev": "vp run gen:exports && vp pack --watch",
    "test": "vp test",
    "smoke": "node scripts/smokeDist.mjs",
    "check": "vp check",
    "check:dist-types": "node scripts/checkDistTypes.mjs",
    "check:entries": "node --experimental-strip-types scripts/checkEntries.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "25.9.9",
    "bumpp": "12.2.0",
    "publint": "0.3.25",
    "tinyglobby": "0.2.17",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
